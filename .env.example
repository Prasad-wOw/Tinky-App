# ============================================================
#  OmniType — Environment Variable Reference
#
#  Copy this file to ".env" and fill in values as needed.
#  OmniType reads these at startup via os.environ.
#
#  These variables are OPTIONAL; sane defaults apply when unset.
#  Do NOT commit a populated .env file to version control.
# ============================================================

# ------------------------------------------------------------
#  OMNITYPE_LOG_LEVEL
#
#  Controls the verbosity of OmniType's log output.
#
#  Valid values (case-insensitive):
#    DEBUG    — verbose; includes internal state transitions
#    INFO     — normal operational messages          (default)
#    WARNING  — only potential problems
#    ERROR    — only errors that affect functionality
#    CRITICAL — only fatal errors
#
#  Note: Raw user text is NEVER written to logs regardless of level.
# ------------------------------------------------------------
OMNITYPE_LOG_LEVEL=INFO

# ------------------------------------------------------------
#  OMNITYPE_DEV_MODE
#
#  When set to "1" or "true", OmniType enables additional
#  developer-facing behaviours:
#    • Logs are also printed to stdout (StreamHandler)
#    • Tracebacks are printed in full
#    • Hot-reload for UI assets may be enabled in future builds
#
#  Set to "0" or "false" (or leave unset) for production use.
# ------------------------------------------------------------
OMNITYPE_DEV_MODE=0

# ------------------------------------------------------------
#  OMNITYPE_APPDATA_DIR
#
#  Override the directory used for config, database, logs, and
#  encryption salt.  Useful for portable installs or CI runs.
#
#  Default (when unset):  %APPDATA%\OmniType
#                         (e.g. C:\Users\<you>\AppData\Roaming\OmniType)
#
#  Example overrides:
#    OMNITYPE_APPDATA_DIR=D:\OmniTypePortable
#    OMNITYPE_APPDATA_DIR=C:\CI\OmniType
# ------------------------------------------------------------
OMNITYPE_APPDATA_DIR=
